{
  "ci": {
    "collect": {
      "staticDistDir": "_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/services/index.html",
        "http://localhost/about/index.html",
        "http://localhost/en/services/index.html",
        "http://localhost/booking/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/blog.html",
        "http://localhost/blog/tax-loss-harvesting-po-balgarski.html",
        "http://localhost/en/blog/lichen-ili-firmen-akaunt-broker.html",
        "http://localhost/vlog/index.html",
        "http://localhost/projects/index.html",
        "http://localhost/partners/index.html",
        "http://localhost/donate/index.html",
        "http://localhost/game/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/en/accessibility/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-first-run"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-byte-weight": [
              "warn",
              {
                "maxNumericValue": 512000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-byte-weight": [
              "warn",
              {
                "maxNumericValue": 512000
              }
            ],
            "is-crawlable": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
