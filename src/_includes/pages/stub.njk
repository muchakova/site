{%- set home = 'home' | urlFor(lang, collections.i18nMap, site.routes) -%}
<section class="section" aria-labelledby="page-title">
  <div class="wrap stack" style="--stack: var(--space-m)">
    <nav class="breadcrumb" aria-label="{{ T.a11y.breadcrumb }}"><ol><li><a href="{{ home }}">{{ T.nav.home }}</a></li><li><a href="{{ page.url }}" aria-current="page">{{ title }}</a></li></ol></nav>
    <h1 id="page-title">{{ title }}</h1>
    <p class="lead measure">{{ T.stub.notice }}</p>
    {% if key == "services" %}
    <ul class="grid" role="list" style="--grid-min: 26rem">
      {% for s in services %}
      <li id="{{ s.id }}"><article class="card service-card"><span class="service-card__icon">{% icon s.icon %}</span><h2 class="card__title">{{ s.title[lang] }}</h2><p class="card__text">{{ s.desc[lang] }}</p></article></li>
      {% endfor %}
    </ul>
    {% endif %}
    <p><a class="link-arrow" href="{{ home }}">{{ T.stub.back }} {% icon "arrow-right" %}</a></p>
  </div>
</section>
