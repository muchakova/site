{%- set map = collections.i18nMap -%}
{%- set H = T.home -%}
{%- set bookingUrl = 'booking' | urlFor(lang, map, site.routes) -%}
{%- set servicesUrl = 'services' | urlFor(lang, map, site.routes) -%}

{# ---------------------------------------------------------------- Hero #}
<section class="hero" id="hero" aria-labelledby="hero-name">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="status-dot">{{ H.pill }}</p>
      <p class="hero__greet">{{ H.greeting }}</p>
      <h1 class="hero__name" id="hero-name">{{ T.site.name }}</h1>
      <p class="hero__role">{{ T.site.role }}</p>
      <p class="hero__lede">{{ H.lede }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="{{ bookingUrl }}">{{ H.ctaBook }} {% icon "arrow-right" %}</a>
        <a class="btn btn--secondary" href="#pricing">{{ H.ctaServices }}</a>
      </div>
      <p class="hero__trust">{{ H.trustPrefix }} <strong>{{ H.ventures.vesta.name }}</strong>, <strong>{{ H.ventures.academy.name }}</strong> {{ H.trustAnd }} <strong>{{ H.ventures.nabi.name }}</strong></p>
    </div>
    <div class="portrait">
      <img class="portrait__img" src="/images/profile_9.jpg" alt="{{ T.site.name }}" eleventy:widths="440,880,1050" loading="eager" fetchpriority="high" sizes="(min-width: 860px) 440px, calc(100vw - 40px)">
      <ul class="portrait__facts" aria-label="{{ T.a11y.facts }}">
        <li class="fact"><span class="fact__icon">{% icon "calendar" %}</span><p><strong>{{ H.factPriceTitle }}</strong><span>{{ H.factPriceText }}</span></p></li>
        <li class="fact"><span class="fact__icon">{% icon "video" %}</span><p><strong>{{ H.factMeetTitle }}</strong><span>{{ H.factMeetText }}</span></p></li>
      </ul>
    </div>
  </div>
  <div class="wrap">
    <dl class="stats">
      {% for s in H.stats %}
      <div><dt>{{ s.label }}</dt><dd>{{ collections.postIndex.length if s.value == "{posts}" else s.value }}</dd></div>
      {% endfor %}
    </dl>
  </div>
</section>

{# ---------------------------------------------------------------- About (#about kept for old links) #}
<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap split">
    <div class="stack" style="--stack: var(--space-s)">
      <p class="eyebrow">{{ H.aboutEyebrow }}</p>
      <h2 id="about-title">{{ H.aboutTitle }}</h2>
      {% for p in H.aboutBio %}<p class="muted">{{ p }}</p>{% endfor %}
      <p><a class="link-arrow" href="{{ 'about' | urlFor(lang, map, site.routes) }}">{{ H.aboutMore }} {% icon "arrow-right" %}</a></p>
    </div>
    <ul class="contact-list" aria-label="{{ T.nav.projects }}">
      {% for v in site.ventures %}
      {% set V = H.ventures[v.key] %}
      <li>
        {% if v.external %}
        <a class="contact-item" href="{{ v.url }}" target="_blank" rel="noopener"><span class="stack" style="--stack: 2px; flex: 1"><strong>{{ V.name }}</strong><span class="muted" style="font-size: .92rem">{{ V.text }}</span></span>{% icon "external" %}<span class="sr-only"> {{ T.a11y.newTab }}</span></a>
        {% else %}
        <a class="contact-item" href="{{ v.route | urlFor(lang, map, site.routes) }}{{ v.hash }}"><span class="stack" style="--stack: 2px; flex: 1"><strong>{{ V.name }}</strong><span class="muted" style="font-size: .92rem">{{ V.text }}</span></span>{% icon "arrow-right" %}</a>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------------------------------------------------------------- Services #}
<section class="section" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{{ H.servicesEyebrow }}</p>
        <h2 id="services-title">{{ H.servicesTitle }}</h2>
        <p class="lead">{{ H.servicesSub }}</p>
      </div>
    </div>
    <ul class="grid" role="list" style="--grid-min: 26rem">
      {% for s in services %}
      <li>
        <article class="card service-card">
          <span class="service-card__icon">{% icon s.icon %}</span>
          <h3 class="card__title"><a class="card__link" href="{{ servicesUrl }}#{{ s.id }}">{{ s.title[lang] }}</a></h3>
          <p class="card__text">{{ s.desc[lang] }}</p>
          <ul class="chips" aria-label="{{ T.a11y.topics }}">{% for l in s.laws[lang] %}<li class="chip chip--signal">{{ l }}</li>{% endfor %}</ul>
          <span class="card__more" aria-hidden="true">{{ H.more }} {% icon "arrow-right" %}</span>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% include "partials/steps.njk" %}

{% include "partials/pricing.njk" %}

{# ---------------------------------------------------------------- Latest articles (#blog) #}
{%- set lead = collections.postIndex[0] -%}
<section class="section" id="blog" aria-labelledby="blog-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head__text"><p class="eyebrow">{{ H.blogEyebrow }}</p><h2 id="blog-title">{{ H.blogTitle }}</h2></div>
      <a class="link-arrow" href="{{ 'blog' | urlFor(lang, map, site.routes) }}">{{ H.allPosts }} {% icon "arrow-right" %}</a>
    </div>
    <div class="post-feed">
      <article class="post-lead">
        <div>
          <p class="card__meta"><span class="cat">{{ lead.tag[lang] }}</span><time datetime="{{ lead.date }}">{{ lead.date | date(lang) }}</time><span>{{ lead.minutes[lang] }} {{ T.units.minRead }}</span></p>
          <h3 class="post-lead__title"><a class="card__link" href="{{ lead.url }}">{{ lead.title[lang] }}</a></h3>
          <p>{{ lead.excerpt[lang] }}</p>
        </div>
        <span class="post-lead__go" aria-hidden="true">{% icon "arrow-right" %}</span>
      </article>
      <ul class="post-rows">
        {% for p in collections.postIndex.slice(1, 4) %}
        <li><article class="post-row"><time datetime="{{ p.date }}">{{ p.date | date(lang, "short") }}</time><div><span class="cat">{{ p.tag[lang] }}</span><h3 class="post-row__title"><a class="card__link" href="{{ p.url }}">{{ p.title[lang] }}</a></h3></div><span class="len">{{ p.minutes[lang] }} {{ T.units.min }}</span></article></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ---------------------------------------------------------------- Videos (#vlog) #}
<section class="section" id="vlog" aria-labelledby="vlog-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head__text"><p class="eyebrow">{{ H.videoEyebrow }}</p><h2 id="vlog-title">{{ H.videoTitle }}</h2>{% if H.videoLanguageNote %}<p class="muted">{{ H.videoLanguageNote }}</p>{% endif %}</div>
      <a class="link-arrow" href="{{ 'vlog' | urlFor(lang, map, site.routes) }}">{{ H.allVideos }} {% icon "arrow-right" %}</a>
    </div>
    <ul class="grid" role="list" style="--grid-min: 18rem">
      {% for v in videos %}
      <li>{% include "partials/video-card.njk" %}</li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------------------------------------------------------------- FAQ #}
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-head"><div class="section-head__text"><h2 id="faq-title">{{ H.faqTitle }}</h2></div></div>
    <div class="faq measure">
      {% for f in H.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
    </div>
  </div>
</section>

{% include "partials/cta.njk" %}
