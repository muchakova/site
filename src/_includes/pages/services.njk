{%- set map = collections.i18nMap -%}
{%- set S = T.servicesPage -%}
{%- set home = 'home' | urlFor(lang, map, site.routes) -%}
{%- set bookingUrl = 'booking' | urlFor(lang, map, site.routes) -%}

<section class="page-head" aria-labelledby="page-title">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="{{ T.a11y.breadcrumb }}"><ol><li><a href="{{ home }}">{{ T.nav.home }}</a></li><li><a href="{{ page.url }}" aria-current="page">{{ title }}</a></li></ol></nav>
    <p class="eyebrow" style="margin-top: var(--space-m)">{{ T.home.servicesEyebrow }}</p>
    <h1 id="page-title">{{ title }}</h1>
    <p class="lead measure">{{ T.home.servicesSub }}</p>
    <nav class="page-nav" aria-label="{{ S.onThisPage }}">
      <ul>
        {% for s in services %}<li><a href="#{{ s.id }}">{{ s.title[lang] }}</a></li>{% endfor %}
        <li><a href="#pricing">{{ S.nav.pricing }}</a></li>
        <li><a href="#terms">{{ S.nav.terms }}</a></li>
        <li><a href="#faq">{{ S.nav.faq }}</a></li>
        <li><a href="#accounting">{{ S.nav.accounting }}</a></li>
      </ul>
    </nav>
  </div>
</section>

{% for s in services %}
<section class="section{% if loop.index is odd %} section--alt{% endif %}" id="{{ s.id }}" aria-labelledby="{{ s.id }}-title">
  <div class="wrap">
    <div class="service-area__head">
      <span class="service-card__icon">{% icon s.icon %}</span>
      <div>
        <h2 id="{{ s.id }}-title">{{ s.title[lang] }}</h2>
        <p class="lead">{{ s.desc[lang] }}</p>
        <ul class="chips" aria-label="{{ T.a11y.topics }}">{% for l in s.laws[lang] %}<li class="chip chip--signal">{{ l }}</li>{% endfor %}</ul>
      </div>
    </div>
    <div class="service-area__grid">
      <div class="card"><h3>{{ S.forWhom }}</h3><p class="card__text">{{ s.forWhom[lang] }}</p></div>
      <div class="card"><h3>{{ S.questions }}</h3><ul class="checklist">{% for q in s.questions[lang] %}<li>{{ q }}</li>{% endfor %}</ul></div>
      <div class="card"><h3>{{ S.outcome }}</h3><p class="card__text">{{ s.outcome[lang] }}</p></div>
    </div>
    <div class="service-area__related">
      <h3>{{ S.related }}</h3>
      <div class="post-feed">
        <ul class="post-rows">
          {% for p in s.posts | postsByUrl(collections.postIndex) %}
          <li><article class="post-row"><time datetime="{{ p.date }}">{{ p.date | date(lang, "short") }}</time><div><span class="cat">{{ p.tag[lang] }}</span><h4 class="post-row__title"><a class="card__link" href="{{ p.url }}">{{ p.title[lang] }}</a></h4></div><span class="len">{{ p.minutes[lang] }} {{ T.units.min }}</span></article></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <p class="service-area__cta"><a class="btn btn--primary" href="{{ bookingUrl }}">{{ S.bookTopic }} {% icon "arrow-right" %}</a></p>
  </div>
</section>
{% endfor %}

{% include "partials/pricing.njk" %}

{% include "partials/steps.njk" %}

<section class="section section--alt" id="terms" aria-labelledby="terms-title">
  <div class="wrap">
    <div class="section-head"><div class="section-head__text"><p class="eyebrow">{{ S.termsEyebrow }}</p><h2 id="terms-title">{{ S.termsTitle }}</h2></div></div>
    <dl class="terms">
      {% for t in S.terms %}
      {% if t.text or showPending %}<div><dt>{{ t.title }}</dt><dd>{% if t.text %}<span>{{ t.text | contactLinks(site) | safe }}</span>{% endif %}{% if t.pending %}{% pending t.pending | replace("q", ""), T.pending[t.pending] %}{% endif %}</dd></div>{% endif %}
      {% endfor %}
    </dl>
  </div>
</section>

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-head"><div class="section-head__text"><h2 id="faq-title">{{ T.home.faqTitle }}</h2></div></div>
    <div class="faq measure">
      {% for f in S.faq %}
      {% if f.a or showPending %}<details><summary>{{ f.q }}</summary><div class="stack" style="--stack: var(--space-2xs)">{% if f.a %}<p>{{ f.a | contactLinks(site) | safe }}</p>{% endif %}{% if f.pending and showPending %}<p>{% pending f.pending | replace("q", ""), T.pending[f.pending] %}</p>{% endif %}</div></details>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="accounting" aria-labelledby="accounting-title">
  <div class="wrap">
    <div class="section-head"><div class="section-head__text"><p class="eyebrow">{{ S.accounting.eyebrow }}</p><h2 id="accounting-title">{{ S.accounting.title }}</h2><p class="lead">{{ S.accounting.text }}</p></div></div>
    <p><a class="btn btn--secondary" href="{{ S.accounting.url }}" target="_blank" rel="noopener">{{ S.accounting.link }} {% icon "external" %}<span class="sr-only"> {{ T.a11y.newTab }}</span></a></p>
  </div>
</section>

{% set ctaId = "consult" %}
{% include "partials/cta.njk" %}
