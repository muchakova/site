---
layout: layouts/base.njk
---
{#- Long documents (privacy policy, accessibility statement): the body is the page's own HTML,
    every <h2 id> becomes an entry in the table of contents. -#}
{%- set map = collections.i18nMap -%}
{%- set D = T.docPage -%}
{%- set body = content | localizeLinks(lang, map) -%}
{%- set headings = body | toc -%}
<article data-article aria-labelledby="page-title">
  <header class="page-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="{{ T.a11y.breadcrumb }}"><ol><li><a href="{{ 'home' | urlFor(lang, map, site.routes) }}">{{ T.nav.home }}</a></li><li><a href="{{ page.url }}" aria-current="page">{{ title }}</a></li></ol></nav>
      <h1 id="page-title" style="margin-top: var(--space-m)">{{ title }}</h1>
      <p class="lead measure">{{ lead }}</p>
      <p class="muted doc-updated">{{ D.updated }} <time datetime="{{ updated | isoDate }}">{{ updated | date(lang) }}</time></p>
    </div>
  </header>

  <div class="wrap post-layout doc-layout">
    <div class="post-main">
      <details class="toc-mobile">
        <summary>{{ D.toc }}</summary>
        <nav class="toc" aria-label="{{ D.tocNav }}"><ol>{% for h in headings %}<li><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ol></nav>
      </details>
      <div class="prose">
{{ body | safe }}
      </div>
    </div>
    <div class="toc-desktop">
      <nav class="toc" aria-labelledby="toc-title"><p class="toc__title" id="toc-title">{{ D.toc }}</p><ol>{% for h in headings %}<li><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ol></nav>
    </div>
  </div>
</article>
