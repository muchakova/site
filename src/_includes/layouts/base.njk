{%- set other = "en" if lang == "bg" else "bg" -%}
{%- set alts = collections.i18nMap[key] if key else {} -%}
{%- set shortTitle = seoTitle or title -%}
{%- set pageTitle = (shortTitle + " — " + T.site.name) if shortTitle else T.home.title -%}
{%- if pageTitle.length > 65 %}{% set pageTitle = shortTitle %}{% endif -%}
{%- set pageDescription = description or T.site.description -%}
{%- set map = collections.i18nMap -%}
{%- set ogPath = ogImage or (page.url | ogFor) -%}
{%- set ogUrl = site.url + ogPath -%}
{%- set ldKind = "article" if ogType == "article" else (key if key in ["home", "about", "services", "booking", "contact", "blog"] else "") -%}
{%- set ldLinks = { home: 'home' | urlFor(lang, map, site.routes), booking: 'booking' | urlFor(lang, map, site.routes), blog: 'blog' | urlFor(lang, map, site.routes) } -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">
  {% endif %}
  {% if i18nExempt %}<meta name="mm:i18n" content="bg-only">
  {% endif %}
  {% if not is404 %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}
  {% if alts.bg and alts.en %}
  <link rel="alternate" hreflang="bg" href="{{ site.url }}{{ alts.bg }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ alts.en }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alts.bg }}">
  {% endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ T.site.name }}">
  <meta property="og:title" content="{{ title or T.home.title }}">
  <meta property="og:description" content="{{ pageDescription }}">
  {% if not is404 %}<meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% endif %}
  <meta property="og:image" content="{{ ogUrl }}">
  {% if "/images/og/" in ogPath %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% endif %}<meta property="og:image:alt" content="{{ title or T.home.title }}">
  <meta property="og:locale" content="{{ T.locale }}">
  <meta property="og:locale:alternate" content="{{ i18n[other].locale }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#F2F4FA" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#080C19" media="(prefers-color-scheme: dark)">
  {{ { kind: ldKind, url: page.url, lang: lang, title: title or T.home.title, description: pageDescription, date: page.date, updated: updated, keywords: keywords, tag: tag, image: ogUrl, site: site, T: T, other: i18n[other], links: ldLinks } | structuredData | safe }}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ T.feed.title }}" href="{{ '/feed.xml' if lang == 'bg' else '/en/feed.xml' }}">
  <script>try{var t=localStorage.getItem('mm-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  {% if lang == "bg" %}<link rel="preload" href="/assets/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
  {% for href in preloadFonts or [] %}<link rel="preload" href="{{ href }}" as="font" type="font/woff2" crossorigin>{% endfor %}
  <link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
  {% for href in extraCss or [] %}<link rel="stylesheet" href="{{ href }}?v={{ assetVersion }}">{% endfor %}
  <script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">{{ T.a11y.skip }}</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
{{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% for src in extraJs or [] %}<script src="{{ src }}?v={{ assetVersion }}" defer></script>{% endfor %}
</body>
</html>
